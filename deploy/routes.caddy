# 12 MiB includes multipart overhead above the unchanged 10 MiB image limit.
request_body {
	max_size 12582912
}
handle_path /static/* {
	root * /srv/static
	file_server
}
handle {
	reverse_proxy app:8000 {
		header_up -Forwarded
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Port
		header_up -X-Real-IP
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}
