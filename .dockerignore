# Allow only immutable runtime inputs. No credentials, development data or QA.
**
!Dockerfile
!.dockerignore
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/manage.py
!backend/config/
!backend/config/*.py
!backend/news/
!backend/news/**
!deploy/
!deploy/gunicorn.conf.py
!prototype/
!prototype/index.html
!prototype/styles.css
!prototype/*.js
!prototype/assets/
!prototype/assets/**
**/__pycache__/**
**/*.pyc
backend/news/tests/**
backend/news/tests
backend/news/management/**
backend/news/management
**/.env*
**/*credential*
**/node_modules/**
**/review/**
**/.local/**
**/.venv/**
**/.private-media/**
**/.static/**
**/.ruff_cache/**
