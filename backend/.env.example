# Reference only. Not loaded automatically; blank required values intentionally fail.
# Production: AWS Ubuntu Docker/Compose; actual account/server/domain require separate confirmation.
# Do not copy/reuse backend/.env.local secrets or QA/test database values.
Y3GYM_ENV=production
DJANGO_SECRET_KEY=
Y3GYM_DB_NAME=
Y3GYM_DB_USER=
Y3GYM_DB_PASSWORD=
# Separate bootstrap/backup operator. Never used by the web application.
Y3GYM_DB_ADMIN_USER=
Y3GYM_DB_ADMIN_PASSWORD=
Y3GYM_DB_HOST=
Y3GYM_DB_PORT=
Y3GYM_ALLOWED_HOSTS=
Y3GYM_ADMIN_ORIGIN=
Y3GYM_MEDIA_ROOT=
Y3GYM_STATIC_ROOT=
# Optional: blank means same-site relative prototype links in production.
Y3GYM_PROTOTYPE_URL=
Y3GYM_CSRF_TRUSTED_ORIGINS=
# Enable only after the actual proxy strips/sets the trusted HTTPS header.
Y3GYM_TRUST_PROXY_HTTPS=0
# HSTS duration/subdomain/preload policy remains undecided; default warning is retained.
Y3GYM_SECURE_HSTS_SECONDS=0
Y3GYM_LOG_LEVEL=INFO
# Kakao Maps JavaScript key only. Blank keeps the external-link fallback;
# set it in the private production env to display maps, and register the HTTPS origin.
# After changing it, recreate only app; restart does not reload container env.
Y3GYM_KAKAO_MAP_JS_KEY=
# AWS Ubuntu host: Docker/Compose production deployment (no automatic fallback).
# Store the filled literal KEY=VALUE file outside this repository, mode0600 in mode0700 dir.
Y3GYM_DOMAIN=
Y3GYM_TLS_EMAIL=
# Build a versioned tag using the recorded source fingerprint; never use :latest.
Y3GYM_APP_IMAGE=
# Initial defaults only. Confirm CPU/memory/DB capacity on the selected EC2.
Y3GYM_WORKERS=1
Y3GYM_THREADS=2
Y3GYM_PG_MAX_CONNECTIONS=50
Y3GYM_PG_SHARED_BUFFERS=128MB
Y3GYM_APP_MEMORY=512m
Y3GYM_DB_MEMORY=512m
Y3GYM_PROXY_MEMORY=128m
